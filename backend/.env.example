# Copiar este archivo como backend/.env y completar los valores.
# backend/.env no se sube al repositorio (tiene contraseñas).

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=

# --- Aplicación ---
# URL pública del frontend (se usa en los links de los correos)
APP_URL=http://localhost:5500

# --- Correo (SMTP) ---
# Gmail: MAIL_PASS debe ser una "contraseña de aplicación" (requiere verificación en 2 pasos)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Gestión de Vacantes UTN
